   if not image_path.exists():\n","            print(f\"WARNING: Image not found: {image_path}\")\n","            skipped += 1\n","            continue\n","\n","        # Get actual image dimensions\n","        with Image.open(image_path) as img:\n","            width, height = img.size\n","\n","        label_path = label_dir / (Path(filename).stem + \".txt\")\n","\n","        lines = []\n","\n","        regions = image_info.get(\"regions\", {})\n","\n","        # Process every building polygon\n","        for region_id, region in regions.items():\n","\n","            shape = region.get(\"shape_attributes\", {})\n","\n","            if shape.get(\"name\") != \"polygon\":\n","                continue\n","\n","            xs = shape.get(\"all_points_x\", [])\n","            ys = shape.get(\"all_points_y\", [])\n","\n","            if len(xs) < 3 or len(ys) < 3:\n","                continue\n","\n","            polygon = []\n","\n","            for x, y in zip(xs, ys):\n","\n","                # Normalize coordinates\n","                x_norm = x / width\n","                y_norm = y / height\n","\n","                # Keep coordinates between 0 and 1\n","                x_norm = max(0.0, min(1.0, x_norm))\n","                y_norm = max(0.0, min(1.0, y_norm))\n","\n","                polygon.extend([x_norm, y_norm])\n","\n","            # YOLO segmentation:\n","            # class x1 y1 x2 y2 x3 y3 ...\n","            line = \"0 \" + \" \".join(\n","                f\"{value:.6f}\" for value in polygon\n","            )\n","\n","            lines.append(line)\n","\n","            total_polygons += 1\n","\n","        # Write label file\n","        if lines:\n","\n","            with open(label_path, \"w\") as f:\n","                f.write(\"\\n\".join(lines))\n","\n","            converted += 1\n","\n","        else:\n","            skipped += 1\n","\n","    print(\"\\n========================================\")\n","    print(f\"JSON: {json_path.name}\")\n","    print(\"========================================\")\n","    print(f\"Images converted : {converted}\")\n","    print(f\"Images skipped   : {skipped}\")\n","    print(f\"Polygons saved   : {total_polygons}\")\n","    print(f\"Labels directory : {label_dir}\")\n","\n","\n","# ============================================================\n","# TRAIN\n","# ============================================================\n","\n","convert_via_to_yolo(\n","    train_json,\n","    train_images,\n","    train_labels\n",")\n","\n","\n","# ============================================================\n","# VALIDATION\n","# ============================================================\n","\n","convert_via_to_yolo(\n","    val_json,\n","    val_images,\n","    val_labels\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"j6QblRxeQlbG","executionInfo":{"status":"ok","timestamp":1787751466973,"user_tz":-330,"elapsed":296966,"user":{"displayName":"Shuvam Chattopadhyay","userId":"04126720780206002092"}},"outputId":"04c223f8-2588-4875-90a5-60e5b6e72914"},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","========================================\n","JSON: via_region_data-train.json\n","========================================\n","Images converted : 467\n","Images skipped   : 0\n","Polygons saved   : 11953\n","Labels directory : /content/drive/MyDrive/InstanceBuilding_YOLO/labels/train\n","\n","========================================\n","JSON: via_region_data-val.json\n","========================================\n","Images converted : 56\n","Images skipped   : 0\n","Polygons saved   : 2153\n","Labels directory : /content/drive/MyDrive/InstanceBuilding_YOLO/labels/val\n"]}]},{"cell_type":"code","source":["from pathlib import Path\n","\n","base = Path(\"/content/drive/MyDrive/InstanceBuilding_YOLO\")\n","\n","train_labels = list((base / \"labels\" / \"train\").glob(\"*.txt\"))\n","val_labels = list((base / \"labels\" / \"val\").glob(\"*.tx