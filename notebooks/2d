 Image\n","\n","# ============================================================\n","# 1. LOAD YOUR TRAINED MODEL\n","# ============================================================\n","\n","MODEL_PATH = (\n","    \"/content/drive/MyDrive/InstanceBuilding_YOLO/\"\n","    \"runs/roof_segmentation/weights/best.pt\"\n",")\n","\n","model = YOLO(MODEL_PATH)\n","\n","print(\"Model loaded successfully!\")\n","print(\"Model:\", MODEL_PATH)\n","\n","\n","# ============================================================\n","# 2. SELECT INPUT IMAGE\n","# ============================================================\n","\n","IMAGE_PATH = (\n","    \"/content/drive/MyDrive/InstanceBuilding_YOLO/\"\n","    \"images/val/C_C (115).png\"\n",")\n","\n","# ============================================================\n","# 3. USER INPUTS\n","# ============================================================\n","\n","# IMPORTANT:\n","# Replace this with the REAL GSD of your input image.\n","# Example: 0.5 means each pixel represents 0.5 metres.\n","GSD = 0.5                 # metres / pixel\n","\n","# Fraction of roof considered usable for solar panels\n","USABLE_ROOF_PERCENT = 0.75\n","\n","# Approximate solar capacity density\n","# 1 kW per 10 m² = 0.1 kW/m²\n","SOLAR_KW_PER_M2 = 0.1\n","\n","# Detection confidence threshold\n","CONFIDENCE = 0.50\n","\n","\n","# ============================================================\n","# 4. RUN YOLO SEGMENTATION\n","# ============================================================\n","\n","result = model.predict(\n","    source=IMAGE_PATH,\n","    imgsz=640,\n","    conf=CONFIDENCE,\n","    device=\"cpu\",\n","    verbose=False\n",")[0]\n","\n","print(\"\\nPrediction completed.\")\n","\n","\n","# ============================================================\n","# 5. ORIGINAL IMAGE SIZE\n","# ============================================================\n","\n","original_image = Image.open(IMAGE_PATH)\n","\n","original_width, original_height = original_image.si