P AREA RESULTS\")\n","    print(\"======================================\")\n","\n","    print(f\"GSD                  : {GSD} m/pixel\")\n","    print(f\"Area per pixel       : {area_per_pixel:.4f} m²\")\n","    print(f\"Total roof pixels    : {total_roof_pixels:,}\")\n","    print(f\"Total roof area      : {total_roof_area:,.2f} m²\")\n","\n","\n","    # ========================================================\n","    # 9. USABLE ROOF AREA\n","    # ========================================================\n","\n","    usable_area = (\n","        total_roof_area *\n","        USABLE_ROOF_PERCENT\n","    )\n","\n","    print(\n","        f\"Usable roof area \"\n","        f\"({USABLE_ROOF_PERCENT * 100:.0f}%): \"\n","        f\"{usable_area:,.2f} m²\"\n","    )\n","\n","\n","    # ========================================================\n","    # 10. SOLAR CAPACITY\n","    # ========================================================\n","\n","    solar_capacity_kw = (\n","        usable_area *\n","        SOLAR_KW_PER_M2\n","    )\n","\n","    print(\n","        f\"Estimated solar capacity: \"\n","        f\"{solar_capacity_kw:,.2f} kW\"\n","    )\n","\n","\n","    # ========================================================\n","    # 11. SUMMARY\n","    # ========================================================\n","\n","    print(\"\\n======================================\")\n","    print(\"FINAL SUMMARY\")\n","    print(\"======================================\")\n","\n","    print(f\"Roofs detected       : {len(polygons)}\")\n","    print(f\"Roof area            : {total_roof_area:,.2f} m²\")\n","    print(f\"Usable roof area     : {usable_area:,.2f} m²\")\n","    print(f\"Solar capacity       : {solar_capacity_kw:,.2f} kW\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TU3esde6R2q3","executionInfo":{"status":"ok","timestamp":1787768173737,"user_tz":-330,"elapsed":5106,"user":{"displayName":"Shuvam Chattopadhyay","userId":"04126720780206002092"}